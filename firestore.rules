rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function lessonOk(id) { return id.matches('^g[12]t1(l[0-9]{1,2}|u[12]l[1-4])$'); }
    function starsFor(r, t) { return r * 10 >= t * 9 ? 3 : (r * 10 >= t * 7 ? 2 : (r * 10 >= t * 4 ? 1 : 0)); }

    // ---- ملف الطالب الأساسي: القراءة والكتابة لصاحبه فقط، وبحقول محددة ----
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName','email','photoURL','theme','lastLesson','createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','email','photoURL','theme','lastLesson'])
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['emerald','arctic','obsidian','mono'])
        && (!('displayName' in request.resource.data) || request.resource.data.displayName.size() <= 80)
        && (!('lastLesson' in request.resource.data) || (request.resource.data.lastLesson.path.matches('^grade-[12]/term-1/[a-z0-9-]+/$') && request.resource.data.lastLesson.title.size() <= 80));
      allow delete: if false;

      // ---- تقدم الدروس: معرّف المستند = معرّف الدرس، فلا تتكرر المكافأة ----
      match /progress/{lessonId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && lessonOk(lessonId) && validProgress(request.resource.data, lessonId)
          && request.resource.data.attempts == 1 && request.resource.data.updatedAt == request.time
          && (request.resource.data.completed ? request.resource.data.completedAt == request.time : !('completedAt' in request.resource.data));
        allow update: if isOwner(uid) && validProgress(request.resource.data, lessonId)
          && request.resource.data.attempts == resource.data.attempts + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.gameXp >= resource.data.gameXp
          && request.resource.data.bonusXp >= resource.data.bonusXp
          && (!resource.data.completed || (request.resource.data.completed && request.resource.data.completedAt == resource.data.completedAt))
          && (resource.data.completed || !request.resource.data.completed || request.resource.data.completedAt == request.time);
        allow delete: if false;
      }

      // ---- نتائج الاختبارات: إضافة فقط ----
      match /quizResults/{rid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && lessonOk(request.resource.data.lessonId)
          && request.resource.data.keys().hasOnly(['lessonId','title','right','total','pct','stars','score','at'])
          && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 200
          && request.resource.data.right is int && request.resource.data.right >= 0 && request.resource.data.right <= request.resource.data.total
          && request.resource.data.stars == starsFor(request.resource.data.right, request.resource.data.total)
          && request.resource.data.pct == math.round(request.resource.data.right * 100.0 / request.resource.data.total)
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // ---- سجل النشاط: إضافة فقط ----
      match /activity/{aid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type','title','lessonId','xp','at'])
          && request.resource.data.type in ['lesson','quiz']
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && lessonOk(request.resource.data.lessonId)
          && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 200
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // ---- الإنجازات: معرّفات محددة، إضافة فقط (لا تعديل ولا حذف) ----
      match /achievements/{bid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && bid in ['first-lesson','three-lessons','six-lessons','ten-lessons','all-lessons','first-star3','five-star3','xp-500','grade1-done','grade2-done']
          && request.resource.data.keys().hasOnly(['id','earnedAt','source'])
          && request.resource.data.id == bid
          && request.resource.data.earnedAt == request.time;
        allow update, delete: if false;
      }
    }

    function validProgress(d, lessonId) {
      return d.keys().hasOnly(['lessonId','title','right','total','stars','gameXp','bonusXp','completed','completedAt','attempts','updatedAt'])
        && d.lessonId == lessonId
        && d.title is string && d.title.size() <= 80
        && d.total is int && d.total > 0 && d.total <= 200
        && d.right is int && d.right >= 0 && d.right <= d.total
        && d.stars == starsFor(d.right, d.total)
        && d.gameXp == d.right * 2 + d.stars * 10
        && d.bonusXp == (d.right * 100 >= d.total * 60 ? 50 : 0)
        && d.completed is bool
        && d.completed == (d.bonusXp == 50);
    }

    // أي مسار آخر: مرفوض
    match /{document=**} { allow read, write: if false; }
  }
}
